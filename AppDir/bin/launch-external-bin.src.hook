#!/bin/sh

set -e

SHARUN="$APPDIR"/sharun
GAMEPATH=${XDG_CONFIG_HOME:-~/.config}/starbound-appimage/game-path
mkdir -p "${GAMEPATH%/*}"

if [ "$APPIMAGE_ARCH" = 'x86_64' ]; then
	DLINKER="$APPDIR"/shared/lib/ld-linux-x86-64.so.2
elif [ "$APPIMAGE_ARCH" = 'aarch64' ]; then
	DLINKER="$APPDIR"/shared/lib/ld-linux-aarch64.so.1
else
	>&2 echo "Something broke terribly here"
	exit 1
fi

_get_game_path() {
	zenity --info --text 'Please specify the path to the starbound binary'
	gamelocation=$(zenity --file-selection --file-filter='starbound')

	if [ -f "$gamelocation" ] && [ -f "${gamelocation%/*}"/starbound_server ]; then
		TO_LAUNCH=$gamelocation
		echo "${gamelocation%/*}" > "$GAMEPATH"
		return 0
	fi
	zenity --error 'That is not a valid location!'
	exit 1
}


if [ -f "$GAMEPATH" ]; then
	read -r TO_LAUNCH < "$GAMEPATH"
fi

if [ ! -f "$TO_LAUNCH" ]; then
	_get_game_path
fi

current_interpreter=$(patchelf --print-rpath "$TO_LAUNCH")

if [ "$current_interpreter" != "$DLINKER" ]; then
	find "${TO_LAUNCH%/*}" -type f -maxdepth 1 \
		-exec patchelf --set-interpreter "$DLINKER" {} \; 2>/dev/null || :
	find "${TO_LAUNCH%/*}" -type f -maxdepth 1 \
		-exec patchelf --set-rpath '$ORIGIN' {} \; 2>/dev/null || :
fi

cd "${GAMEPATH%/*}"
export LD_LIBRARY_PATH="$PWD:$SHARUN_EXTRA_LIBRARY_PATH:$APPDIR/shared/lib:$APPDIR/shared/lib/pulseaudio:$LD_LIBRARY_PATH"
exec "$SHARUN" env "$TO_LAUNCH" "$@"
